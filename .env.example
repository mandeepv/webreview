# ── Site ────────────────────────────────────────────────────────────────────
# No trailing slash. Locally: http://localhost:3000. Production: your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App Store link shown on /welcome (and in the handoff email via edge function).
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/kinderwell/id6758403231

# ── Pricing (display only — the CHARGED price lives on the Dodo product) ────
# Keep these in sync with the Dodo dashboard products AND the app's IAP prices.
NEXT_PUBLIC_PRICE_ANNUAL=59.99
NEXT_PUBLIC_PRICE_MONTHLY=12.99

# ── Supabase (dev project for local/preview; prod project ONLY on Vercel prod)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── PostHog (same project as the iOS app — one user journey) ────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Dodo mode ────────────────────────────────────────────────────────────────
# The checkout overlay takes test/live from the checkout URL itself, so this
# doesn't affect checkout. It decides two other things:
#   * /manage: `test` sends subscribers to Dodo's TEST customer portal;
#     anything else (or unset) sends them to the live one;
#   * `live` hard-disables the NEXT_PUBLIC_DEV_SKIP preview buttons.
# `test` for local/preview against the dev project; `live` on Vercel
# Production at go-live. Check: curl -sI https://kinderwell.app/manage →
# Location is customer.dodopayments.com (not test.customer…).
NEXT_PUBLIC_DODO_ENV=test

# ── Meta Pixel ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# ── Server-only (NO NEXT_PUBLIC_ prefix — must never reach the browser) ─────
# Same value as the FUNNEL_PROXY_SECRET Supabase secret. The /api/* proxy
# sends it; the edge functions refuse calls without it (always, in live mode).
FUNNEL_PROXY_SECRET=

# ── Customer portal (kinderwell.app/manage) ────────────────────────────────
# Dodo business id (dashboard) → /manage opens Dodo's business-specific login,
# on the live host unless NEXT_PUBLIC_DODO_ENV=test. Unset → Dodo's Unified Portal.
NEXT_PUBLIC_DODO_BUSINESS_ID=
# Full override, if ever needed:
# NEXT_PUBLIC_DODO_PORTAL_URL=https://customer.dodopayments.com/login/<business_id>
