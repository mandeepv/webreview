{
  "name": "kinderwell-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:functions",
    "check:functions": "cd supabase/functions && deno check --node-modules-dir=none */index.ts _testing/*.ts _integration/*.ts",
    "test:web": "vitest run",
    "test:functions": "deno test --allow-env --node-modules-dir=none --ignore=supabase/functions/_integration supabase/functions/",
    "test:integration": "INTEGRATION_TESTS=1 deno test --allow-all --node-modules-dir=none supabase/functions/_integration/",
    "test:db": "supabase test db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dodopayments-checkout": "^1.9.9",
    "lucide-react": "^1.47.0",
    "next": "^15.1.0",
    "posthog-js": "^1.200.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
